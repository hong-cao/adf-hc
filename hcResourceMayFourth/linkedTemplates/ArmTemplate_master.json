{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "hcResourceMayFourth"
		},
		"LS_file_validation_hc_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_file_validation_hc'"
		},
		"LS_httpmayfourth_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_httpmayfourth'"
		},
		"LS_mayfourth_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_mayfourth'"
		},
		"HttpServer1_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://github.com"
		},
		"LS_KeyVault_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://kv-novaretail-1.vault.azure.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "hcResourceMayFourth_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_file_validation_hc_connectionString": {
						"value": "[parameters('LS_file_validation_hc_connectionString')]"
					},
					"LS_httpmayfourth_connectionString": {
						"value": "[parameters('LS_httpmayfourth_connectionString')]"
					},
					"LS_mayfourth_connectionString": {
						"value": "[parameters('LS_mayfourth_connectionString')]"
					},
					"HttpServer1_properties_typeProperties_url": {
						"value": "[parameters('HttpServer1_properties_typeProperties_url')]"
					},
					"LS_KeyVault_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_properties_typeProperties_baseUrl')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}