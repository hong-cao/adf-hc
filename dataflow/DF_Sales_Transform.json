{
	"name": "DF_Sales_Transform",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Sales_Input",
						"type": "DatasetReference"
					},
					"name": "SrcSalesInput"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          OrderID as short,",
				"          Product as string,",
				"          Quantity as short,",
				"          {Price } as short",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcSalesInput"
			]
		}
	}
}