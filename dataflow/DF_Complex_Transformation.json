{
	"name": "DF_Complex_Transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Sales",
						"type": "DatasetReference"
					},
					"name": "SrcSales"
				},
				{
					"dataset": {
						"referenceName": "DS_Products",
						"type": "DatasetReference"
					},
					"name": "SrcProducts"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "LKPProductMaster"
				}
			],
			"scriptLines": [
				"source(output(",
				"          SalesOrderNumber as string,",
				"          SalesOrderLineNumber as boolean,",
				"          OrderDate as date,",
				"          CustomerName as string,",
				"          EmailAddress as string,",
				"          Item as string,",
				"          Quantity as boolean,",
				"          UnitPrice as double,",
				"          TaxAmount as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcSales",
				"source(output(",
				"          ProductID as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          ListPrice as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcProducts",
				"SrcSales, SrcProducts lookup(Item == ProductName,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> LKPProductMaster"
			]
		}
	}
}