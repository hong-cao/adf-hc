{
	"name": "DF_Complex_Transformation",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Sales",
						"type": "DatasetReference"
					},
					"name": "SrcSales"
				},
				{
					"dataset": {
						"referenceName": "DS_Products",
						"type": "DatasetReference"
					},
					"name": "SrcProducts"
				}
			],
			"sinks": [],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          SalesOrderNumber as string,",
				"          SalesOrderLineNumber as string,",
				"          OrderDate as string,",
				"          CustomerName as string,",
				"          EmailAddress as string,",
				"          Item as string,",
				"          Quantity as string,",
				"          UnitPrice as string,",
				"          TaxAmount as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcSales",
				"source(output(",
				"          ProductID as string,",
				"          ProductName as string,",
				"          Category as string,",
				"          ListPrice as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> SrcProducts"
			]
		}
	}
}